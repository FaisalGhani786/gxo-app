# Copy to .env.local for local development. Never commit .env.local.
# On Vercel these live in Project → Settings → Environment Variables.

# Supabase → Project Settings → API (safe to expose; RLS protects the data)
NEXT_PUBLIC_SUPABASE_URL=https://gdycicmglmrangxhitgj.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Public site URL, used in email links and Stripe redirects
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Optional: card payments (Stripe). Without these, orders stay "pending"
# and you mark them paid from /admin/orders after a bank transfer. ──
# Server only. Supabase → Project Settings → API keys → service_role / secret key.
# Used only by the Stripe webhook to unlock purchases.
SUPABASE_SERVICE_ROLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
